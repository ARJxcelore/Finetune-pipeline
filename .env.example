# Model
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MODEL_REVISION=main
SEQUENCE_LEN=2560

# 8 GB RTX 4060 baseline
MICRO_BATCH_SIZE=1
GRAD_ACCUMULATION=8
EPOCHS=3
LEARNING_RATE=0.0002
SEED=42
VALID_RATIO=0.2

# Tracking
USE_WANDB=true
WANDB_PROJECT=auto-finetuning
WANDB_ENTITY=
WANDB_API_KEY=

# Evaluation gate
EVAL_MIN_F1=0.35
EVAL_MAX_SAMPLES=20
EVAL_MAX_NEW_TOKENS=400

# Hugging Face
HF_TOKEN=
HF_MODEL_REPO=
HF_PRIVATE=true
# Movable branch that serving pins to (revision=...). Each gated release also gets
# an immutable run-<run-id> tag; rollback = point this alias at an earlier tag.
# Set empty to upload and tag without promoting.
HF_PRODUCTION_ALIAS=production

# Optional
AXOLOTL_IMAGE=axolotlai/axolotl:0.18.0
HF_CACHE_DIR=./.cache/huggingface

# HDFS anomaly-classification experiment (see docs/HDFS_ANOMALY_DETECTION.md)
WANDB_PROJECT_HDFS=hdfs-anomaly-classification
MAX_TRAIN_SAMPLES=

# HDFS in-pipeline evaluation. Stratified because the real prior is 2.93% anomaly:
# a representative sample has too few anomalies to measure recall.
EVAL_ANOMALIES=100
EVAL_NORMALS=100

# HDFS release gate -- nothing is uploaded to HF_MODEL_REPO unless all of these pass.
# Defaults sit ~10 points under the observed fine-tuned run (100 / 0.995 / 0.99 / 0.995 / 0.999).
HDFS_GATE_MIN_SCHEMA_VALID_PCT=90.0
HDFS_GATE_MIN_ACCURACY=0.90
HDFS_GATE_MIN_ANOMALY_RECALL=0.85
HDFS_GATE_MIN_ANOMALY_F1=0.85
HDFS_GATE_MIN_EVIDENCE_GROUNDING=0.90
